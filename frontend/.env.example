# Browser-safe Supabase project values; never put service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave empty in local development to use the Vite proxy on port 8000.
VITE_API_BASE_URL=
# Explicit local test harness only. Production builds reject true.
VITE_LOCAL_SANDBOX=
