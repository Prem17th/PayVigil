# Placeholder-only production reference. No credentials or service URLs belong in Git.
# Supply values through Render environment settings or an approved secret manager.
# Do not upload this combined file to the frontend service.

APP_ENV=production
# Restricted LOGIN role inheriting beforetransfer_api; never the database owner.
# Copy the selected Render PostgreSQL endpoint; URL-encode its database password.
# Accepted schemes: postgresql://, postgres://, postgresql+psycopg://.
DATABASE_URL=
# Privileged deployment credential used only by Alembic. Removed before API start.
MIGRATION_DATABASE_URL=
PGSSLMODE=verify-full
# Or an absolute path to the selected database provider's verified CA bundle.
PGSSLROOTCERT=system
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never put this privileged Storage credential in VITE_* variables.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=beforetransfer-evidence
# Comma-separated exact HTTPS frontend origins; no wildcard or path.
CORS_ORIGINS=

# Public frontend build-time configuration only; explicit hosted values required.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Real HTTPS API origin, without /api or a trailing slash.
VITE_API_BASE_URL=
# Production builds reject the synthetic development identity switch.
VITE_LOCAL_SANDBOX=false


# Independent payment worker: restricted LOGIN inheriting beforetransfer_worker.
WORKER_DATABASE_URL=
PAYMENTS_SANDBOX_URL=
PAYMENTS_SANDBOX_API_KEY=
PAYMENTS_REQUEST_TIMEOUT_SECONDS=3
PAYMENTS_POLL_SECONDS=1

# Independent fake-transfer ledger service; separate database and restricted role.
SANDBOX_APP_ENV=production
SANDBOX_DATABASE_URL=
SANDBOX_MIGRATION_DATABASE_URL=
SANDBOX_API_KEY=
SANDBOX_PGSSLMODE=verify-full
SANDBOX_PGSSLROOTCERT=system
SANDBOX_LOST_RESPONSE_DELAY_SECONDS=10
SANDBOX_VISIBILITY_DELAY_SECONDS=15

# Read-only investigation agent; model must support Responses function calling.
OPENAI_API_KEY=
OPENAI_MODEL=
# Advisory redacted memory, never beneficiary or payment authority.
BREETH_API_KEY=

# Published n8n webhook uses a configured header-auth credential.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_CALLBACK_SECRET=
N8N_CALLBACK_AUTH_MODE=header
# Optional self-hosted workflow convention. Cloud template uses a fixed node URL.
BEFORETRANSFER_API_ORIGIN=

# Stock voice explanation only; no identity verification or voice approvals.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Dodo test.dodopayments.com only, SaaS subscription billing only.
DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
BILLING_FRONTEND_ORIGIN=

# Operator release tooling only; these never enter application/browser services.
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_REPO_URL=
RENDER_BRANCH=
RENDER_NAME_PREFIX=payvigil
RENDER_REGION=singapore
RENDER_COMPUTE_PLAN=starter

# Hosted verification: separate controlled users; never record tokens in reports.
VERIFY_API_URL=
VERIFY_WEB_URL=
VERIFY_FINANCE_TOKEN=
VERIFY_SUPPLIER_TOKEN=
VERIFY_UNASSIGNED_TOKEN=
