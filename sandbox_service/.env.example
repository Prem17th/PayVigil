# Independent database and generated shared key; never reuse the application DB.
SANDBOX_DATABASE_URL=
SANDBOX_MIGRATION_DATABASE_URL=
SANDBOX_API_KEY=
SANDBOX_APP_ENV=production
SANDBOX_PGSSLMODE=verify-full
SANDBOX_PGSSLROOTCERT=system
SANDBOX_LOST_RESPONSE_DELAY_SECONDS=10
SANDBOX_VISIBILITY_DELAY_SECONDS=15
